# For details & more options, see documentation/AppManifests.md in firmware repo

App(
    appid="flipper_diver",
    name="Flipper Diver",
    apptype=FlipperAppType.EXTERNAL,
    entry_point="flipper_diver_app",
    stack_size=4 * 1024,  # the main thread writes the record (FlipperFormat)
    # C only (the default "*.c*" also matches *.cpython-*.pyc); tests/ is
    # built on the host by `unit-tests`.
    sources=["*.c", "!tests"],
    fap_category="Games",
    fap_version="0.1",
    fap_icon="flipper_diver.png",  # 10x10 1-bit PNG
    fap_icon_assets="images",  # stratagem icons, see tools/make_icons.py
    fap_description="Stratagem input minigame inspired by Helldivers 2",
    fap_author="safenein",
)
